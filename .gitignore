# IDE and editor files
.claude/
.vscode/
.idea/
*.swp
*.swo
*~

# Build artifacts
bin/
dist/
build/
*.o
*.so
*.a

# Go related
*.exe
*.test
*.prof
vendor/

# eBPF related
# The bpf2go-generated Go bindings (*_bpfel.go / *_bpfeb.go) AND the compiled
# objects they //go:embed (pkg/ebpf/*.o) are committed, so `go build ./...` works
# from a clean checkout with no clang/codegen step. Regenerate with `make ebpf`.
# All other *.o (e.g. the redundant manual bpf/*.o compile artifacts) stay ignored.
*.bpf.o
*.o
!pkg/ebpf/*.o

# Testing and coverage
coverage.out
coverage.html
*.cover
test-results/
.test/

# Temporary files
*.tmp
*.temp
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Docker related
Dockerfile.cross

# Kubernetes related
*.kubeconfig
kubeconfig

# Release artifacts
*.tar.gz
*.zip
*.deb
*.rpm

# QEMU/KVM eBPF test VM cache (cloud image, VM disk, seed ISO, SSH keys).
# Large binaries and secrets - never commit. See hack/vm/.
.vmcache/

# Local development
.env
.env.local
.env.*.local

# Git locks
.git/index.lock

# Generated CO-RE kernel header (make vmlinux)
bpf/vmlinux.h

# Compiled output of the VM smoke helper. `go build ./...` inside
# hack/vm/smoke drops the binary next to its source, and a `git add -A` after
# that commits 5.5 MB of ELF.
hack/vm/smoke/pahlevan-vm-smoke

# Scratch renders. The diagram sources live in docs/assets/diagrams/ and the
# images they produce are committed; nothing else from a render run is.
docs/assets/diagrams/*.png
