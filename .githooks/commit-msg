#!/usr/bin/env bash
#
# Reject any commit message carrying AI or assistant attribution.
#
# This repository's history contained three commits carrying an assistant
# co-authorship trailer and a "Generated with" line. They were removed, which
# cost a rewrite of 221 commits and a force-push of a public branch. This hook
# exists so that never has to happen again.
#
# It is a hook rather than a code-review habit because the trailers are added
# by tooling, automatically, at the moment of commit - which is exactly the
# point at which nobody is reading the message.
#
# Enable it once per clone:
#   git config core.hooksPath .githooks
# CONTRIBUTING.md says the same, and scripts/setup-hooks.sh does it for you.

set -euo pipefail

msg_file="$1"

# Trailers and marketing lines that must never appear.
#
# These match on the SHAPE of attribution rather than on a list of vendor
# names, which is both stricter and keeps the names themselves out of the
# tree: every commit here is authored by the person who made it, so any
# co-authorship trailer at all is wrong, whoever it credits. A list of names
# also silently stops working the moment a new tool appears.
patterns=(
	'^[[:space:]]*co-authored-by:'
	'^[[:space:]]*(assisted|authored|generated|created)-by:'
	'generated with'
	'🤖'
)

found=""
for p in "${patterns[@]}"; do
	if match=$(grep -inE "$p" "$msg_file" || true); [ -n "$match" ]; then
		found+="  $match"$'\n'
	fi
done

if [ -n "$found" ]; then
	cat >&2 <<MSG

Commit rejected: the message carries AI or assistant attribution.

$found
This project's commits are authored by the person who made them. Remove the
trailer and commit again.

If you believe this is a false positive, the patterns are in .githooks/commit-msg.
MSG
	exit 1
fi

exit 0
